{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd /home/user/buscador-leads/buscador-leads && python3 app.py &"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": ["Bash", "Read", "Edit", "Write", "Grep", "Glob"]
  }
}
